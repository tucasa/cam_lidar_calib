<?xml version="1.0" encoding="utf-8"?>
<launch>
  <param name ="/use_sim_time" value="true"/>

  <param name = "result_file" type="string" value="$(find cam_lidar_calib)/result/C_T_L_c1_os1.txt"/>

  <param name= "project_only_plane" type="bool" value="false"/>

  <param name = "camera_in_topic" type="string" value="/front_center/image_raw"/>
  <param name = "lidar_in_topic" type="string" value="/ouster/points"/>
  <param name = "camera_name" type="string" value="front_center"/>
  
  <param name = "dist_cut_off" type="int" value="10"/>

  <param name = "cam_config_file_path" type="string" value="$(find cam_lidar_calib)/config/c1_camera0.yaml" />

  <!-- <node pkg="cam_lidar_calib" name="cam_lidar_proj_c1" type="cam_lidar_proj_node" output="screen" launch-prefix="gdb -ex run --><!--args"/> -->
  <node pkg="cam_lidar_calib" name="cam_lidar_proj_c1" type="cam_lidar_proj_node" output="screen"/>

</launch>
