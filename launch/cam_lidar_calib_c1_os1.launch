<?xml version="1.0" encoding="utf-8"?>
<launch>

  <param name ="/use_sim_time" value="false"/>
  <node  pkg="cam_lidar_calib" name="cam_lidar_calib_c1_os1" type="cam_lidar_calib_node" output="screen">
  	<param name = "dx" type="double" value="0.075"/>
  	<param name = "dy" type="double" value="0.075"/>

  	<param name = "checkerboard_rows" type = "int" value = "9" />
  	<param name = "checkerboard_cols" type = "int" value = "6" />

  	<param name = "result_file" type="string" value="$(find cam_lidar_calib)/result/C_T_L_c1_os1.txt"/>
  	<param name = "result_rpy_file" type="string" value="$(find cam_lidar_calib)/result/rpy_txyz_c1_os1.txt"/>

  	<param name = "min_points_on_plane" type="int" value="700"/>
  	<param name = "num_views" type="int" value="14"/>

    <param name = "no_of_initializations" type="int" value="5"/>
    <param name = "initializations_file" value="$(find cam_lidar_calib)/result/random_init.txt"/>
  	
	<param name = "camera_in_topic" type="string" value="/front_center/image_raw"/>
  	<param name = "lidar_in_topic" type="string" value="/ouster/points"/>

	<param name="x_min" value="0.75"/>
    <param name="x_max" value="4"/>
    <param name="y_min" value="-1"/>
    <param name="y_max" value="1"/>
    <param name="z_min" value="-1"/>
    <param name="z_max" value="2"/>
    <param name="ransac_threshold" value="0.01"/>

  	<param name = "cam_config_file_path" type="string" value="$(find cam_lidar_calib)/config/c1_camera0.yaml" />
  </node>
</launch>
